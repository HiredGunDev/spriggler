{
  "version": "0.3",
  "name": "Shed - Real Sensors, Mock Devices",
  "units": {"temperature": "F"},

  "environments": {
    "flower": {"description": "Flower chamber"}
  },

  "sensors": {
    "flower_sensor": {
      "driver": "govee_ble",
      "environment": "flower",
      "properties": ["temperature", "humidity"],
      "driver_config": {
        "address": "2C6A",
        "scan_timeout": 120
      }
    },
    "ambient_sensor": {
      "driver": "govee_ble",
      "environment": "ambient",
      "properties": ["temperature", "humidity"],
      "driver_config": {
        "address": "627A",
        "scan_timeout": 120
      }
    }
  },

  "devices": {
    "flower_heater": {
      "driver": "mock",
      "environment": "flower",
      "circuit": "main",
      "role": "heater",
      "driver_config": {"address": "mock-heater"}
    },
    "flower_light": {
      "driver": "mock",
      "environment": "flower",
      "circuit": "lighting",
      "role": "light",
      "manual_override_minutes": 30,
      "driver_config": {"address": "mock-light"}
    }
  },

  "circuits": {
    "main": {"max_amps": 20, "voltage": 120},
    "lighting": {"max_amps": 15, "voltage": 120}
  },

  "schedules": {
    "flower": {
      "phases": [
        {
          "name": "day",
          "start": "06:00",
          "end": "22:00",
          "targets": {
            "temperature": {"min": 70, "max": 82, "ideal": 76},
            "humidity": {"min": 45, "max": 65, "ideal": 55}
          }
        },
        {
          "name": "night",
          "start": "22:00",
          "end": "06:00",
          "targets": {
            "temperature": {"min": 62, "max": 75, "ideal": 68},
            "humidity": {"min": 45, "max": 65, "ideal": 55}
          }
        }
      ]
    }
  },

  "safety": {
    "environments": {
      "flower": {
        "limits": {
          "temperature": {"absolute_min": 45, "absolute_max": 105},
          "humidity": {"absolute_min": 15, "absolute_max": 90}
        }
      }
    },
    "devices": {
      "flower_heater": {"safe_state": "off"},
      "flower_light": {"safe_state": "current"}
    },
    "sensor_stale_after_missed": 5,
    "safety_loop_interval_seconds": 60
  }
}