{
  "version": "0.3",
  "name": "Seedling Pod",
  "units": {
    "temperature": "F"
  },

  "environments": {
    "seedling": {
      "description": "Seedling tent",
      "connections": {
        "ambient": {
          "via": "seedling_fan",
          "bidirectional": false
        }
      }
    }
  },

  "sensors": {
    "seedling_sensor": {
      "driver": "govee_ble",
      "environment": "seedling",
      "properties": ["temperature", "humidity"],
      "poll_interval_seconds": 60,
      "driver_config": {
        "address": "2650"
      }
    },
    "ambient_sensor": {
      "driver": "govee_ble",
      "environment": "ambient",
      "properties": ["temperature", "humidity"],
      "poll_interval_seconds": 120,
      "driver_config": {
        "address": "627A"
      }
    }
  },

  "devices": {
    "seedling_heater": {
      "driver": "kasa_plug",
      "environment": "seedling",
      "circuit": "seedling_circuit",
      "role": "heater",
      "driver_config": {
        "strip": "seedling",
        "plug": "Heater"
      },
      "power_sensor": {
        "driver": "kasa_plug",
        "driver_config": {
          "strip": "seedling",
          "plug": "Heater"
        }
      }
    },
    "seedling_light": {
      "driver": "kasa_plug",
      "environment": "seedling",
      "circuit": "seedling_circuit",
      "role": "light",
      "driver_config": {
        "strip": "seedling",
        "plug": "Lights"
      },
      "power_sensor": {
        "driver": "kasa_plug",
        "driver_config": {
          "strip": "seedling",
          "plug": "Lights"
        }
      }
    },
    "seedling_fan": {
      "driver": "kasa_plug",
      "environment": "seedling",
      "circuit": "seedling_circuit",
      "role": "exhaust",
      "driver_config": {
        "strip": "seedling",
        "plug": "Fan"
      },
      "power_sensor": {
        "driver": "kasa_plug",
        "driver_config": {
          "strip": "seedling",
          "plug": "Fan"
        }
      }
    },
    "seedling_humidifier": {
      "driver": "vesync_humidifier",
      "environment": "seedling",
      "circuit": "seedling_circuit",
      "role": "humidifier",
      "driver_config": {
        "name": "Dual 200S",
        "email": "bill@hiredgun.dev",
        "password": "VEEnterpriseNX01"
      },
      "power_sensor": {
        "driver": "kasa_plug",
        "driver_config": {
          "strip": "seedling",
          "plug": "Humidifier"
        }
      }
    }
  },

  "circuits": {
    "seedling_circuit": {
      "max_amps": 15,
      "voltage": 120,
      "description": "Seedling strip circuit"
    }
  },

  "schedules": {
    "seedling": {
      "phases": [
        {
          "name": "lights_on",
          "start": "06:00",
          "end": "22:00",
          "targets": {
            "temperature": { "min": 72, "max": 80, "ideal": 76 },
            "humidity": { "min": 60, "max": 80, "ideal": 70 }
          },
          "devices": {
            "seedling_light": "on"
          }
        },
        {
          "name": "lights_off",
          "start": "22:00",
          "end": "06:00",
          "targets": {
            "temperature": { "min": 65, "max": 75, "ideal": 70 },
            "humidity": { "min": 60, "max": 80, "ideal": 70 }
          },
          "devices": {
            "seedling_light": "off"
          }
        }
      ]
    }
  },

  "safety": {
    "environments": {
      "seedling": {
        "limits": {
          "temperature": { "absolute_min": 50, "absolute_max": 95 },
          "humidity": { "absolute_min": 20, "absolute_max": 95 }
        },
        "rate_of_change": {
          "temperature": { "max_per_minute": 2.0 }
        }
      }
    },
    "devices": {
      "seedling_heater": {
        "safe_state": "off",
        "coherence_window_seconds": 300,
        "max_continuous_runtime_minutes": 120
      },
      "seedling_light": {
        "safe_state": "off",
        "coherence_window_seconds": 300,
        "max_continuous_runtime_minutes": 960
      },
      "seedling_fan": {
        "safe_state": "on",
        "coherence_window_seconds": 120
      },
      "seedling_humidifier": {
        "safe_state": "off",
        "coherence_window_seconds": 300
      }
    },
    "sensor_stale_after_missed": 3,
    "safety_loop_interval_seconds": 15,
    "battery_warning_percent": 20,
    "battery_critical_percent": 5,
    "rssi_warning_dbm": -90
  }
}