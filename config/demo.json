{
    "version": "0.3",
    "name": "Demo - Mock Hardware",
    "units": {"temperature": "F"},

    "environments": {
        "chamber": {"description": "Main grow chamber"},
        "pod": {
            "description": "Seedling pod",
            "connections": {
                "chamber": {"via": "transfer_fan"}
            }
        }
    },

    "sensors": {
        "chamber_sensor": {
            "driver": "mock",
            "environment": "chamber",
            "properties": ["temperature", "humidity"],
            "driver_config": {
                "address": "AA:BB:CC:DD:EE:01",
                "temperature": 296.48,
                "humidity": 55.0,
                "drift": 0.3,
                "drop_rate": 0.1
            }
        },
        "pod_sensor": {
            "driver": "mock",
            "environment": "pod",
            "properties": ["temperature", "humidity"],
            "driver_config": {
                "address": "AA:BB:CC:DD:EE:02",
                "temperature": 298.15,
                "humidity": 60.0,
                "drift": 0.2,
                "drop_rate": 0.05
            }
        },
        "ambient_sensor": {
            "driver": "mock",
            "environment": "ambient",
            "properties": ["temperature", "humidity"],
            "driver_config": {
                "address": "AA:BB:CC:DD:EE:03",
                "temperature": 280.37,
                "humidity": 40.0,
                "drift": 0.1,
                "drop_rate": 0.0
            }
        }
    },

    "devices": {
        "chamber_heater": {
            "driver": "mock",
            "environment": "chamber",
            "circuit": "main",
            "role": "heater",
            "driver_config": {"address": "192.168.1.101"}
        },
        "pod_heater": {
            "driver": "mock",
            "environment": "pod",
            "circuit": "main",
            "role": "heater",
            "driver_config": {"address": "192.168.1.102"}
        },
        "chamber_exhaust": {
            "driver": "mock",
            "environment": "chamber",
            "circuit": "main",
            "role": "exhaust",
            "driver_config": {"address": "192.168.1.103"}
        },
        "humidifier": {
            "driver": "mock",
            "environment": "chamber",
            "circuit": "main",
            "role": "humidifier",
            "driver_config": {
                "address": "192.168.1.104",
                "states": ["off", "low", "mid", "high"]
            }
        },
        "transfer_fan": {
            "driver": "mock",
            "environment": "pod",
            "circuit": "main",
            "role": "transfer",
            "driver_config": {"address": "192.168.1.105"}
        },
        "chamber_light": {
            "driver": "mock",
            "environment": "chamber",
            "circuit": "lighting",
            "role": "light",
            "driver_config": {"address": "192.168.1.106"}
        }
    },

    "circuits": {
        "main": {"max_amps": 20, "voltage": 120},
        "lighting": {"max_amps": 15, "voltage": 120}
    },

    "schedules": {
        "chamber": {
            "phases": [
                {
                    "name": "day",
                    "start": "06:00",
                    "end": "22:00",
                    "targets": {
                        "temperature": {"min": 72, "max": 82, "ideal": 77},
                        "humidity": {"min": 50, "max": 65, "ideal": 58}
                    },
                    "devices": {
                        "chamber_light": "on"
                    }
                },
                {
                    "name": "night",
                    "start": "22:00",
                    "end": "06:00",
                    "targets": {
                        "temperature": {"min": 65, "max": 75, "ideal": 70},
                        "humidity": {"min": 50, "max": 65, "ideal": 58}
                    },
                    "devices": {
                        "chamber_light": "off"
                    }
                }
            ]
        },
        "pod": {
            "phases": [{
                "name": "always",
                "start": "00:00",
                "end": "00:00",
                "targets": {
                    "temperature": {"min": 75, "max": 82, "ideal": 78},
                    "humidity": {"min": 60, "max": 75, "ideal": 68}
                }
            }]
        }
    },

    "safety": {
        "environments": {
            "chamber": {
                "limits": {
                    "temperature": {"absolute_min": 45, "absolute_max": 105},
                    "humidity": {"absolute_min": 15, "absolute_max": 90}
                }
            },
            "pod": {
                "limits": {
                    "temperature": {"absolute_min": 55, "absolute_max": 95},
                    "humidity": {"absolute_min": 20, "absolute_max": 90}
                }
            }
        },
        "devices": {
            "chamber_heater": {"safe_state": "off"},
            "pod_heater": {"safe_state": "off"},
            "chamber_exhaust": {"safe_state": "on"},
            "humidifier": {"safe_state": "off"},
            "transfer_fan": {"safe_state": "current"},
            "chamber_light": {"safe_state": "current"}
        },
        "sensor_stale_after_missed": 3,
        "safety_loop_interval_seconds": 5
    }
}
