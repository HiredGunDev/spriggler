# ─────────────────────────────────────────────────────────────────
# Spriggler Secrets
# ─────────────────────────────────────────────────────────────────
# Copy this file to ~/.spriggler/.env and fill in real values.
#
# This file is a TEMPLATE with dummy values — safe to commit.
# The real .env with your credentials lives in SPRIGGLER_HOME,
# NOT in the project directory.
#
# Environment variables listed here are referenced from
# config.toml using the "$VARIABLE_NAME" syntax.
# ─────────────────────────────────────────────────────────────────

# VeSync cloud API credentials (for humidifier control)
SPRIGGLER_VESYNC_EMAIL=your_email@example.com
SPRIGGLER_VESYNC_PASSWORD=your_password_here
